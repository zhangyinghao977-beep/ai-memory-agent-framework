digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontname="Noto Sans CJK SC", fontsize=18, labelloc=t, label="CA ↔ EA ↔ KA"];
node [shape=box, style="rounded,filled", fillcolor="#eef4ff", color="#55718f", fontname="Noto Sans CJK SC", fontsize=12, margin="0.16,0.12"];
edge [color="#55718f", fontname="Noto Sans CJK SC", fontsize=10];
input [label="当前整段话与问题"];
seed [label="训练起步：预设 slot 与 EA\n语言位置＋固定搭配 → 组合知识包\n凝结核，不是使用时的另一入口",fillcolor="#fff5dc"];
ca [label="CA · Chain Attention（旧名 PA）\n跨语句关系、隐含合并、当前问题\n必要时关联远期经历"];
ea [label="EA · 学习事件链\n例：可独立结束的语句部分\n训练好的位置为 slot；每个 slot 对应 KA"];
ka [label="KA · 寻找知识候选队列\n包内参考与成员关系"];
memory [label="既有记忆路线\n关键词／多层索引 → 简介辨别 → 按需原文\n保留参与者、时间、主题与原文关联\n原文不被摘要替换"];
count [label="候选数量？",shape=diamond];
none [label="直接询问\n不为未找到额外登记",fillcolor="#fff5dc"];
many [label="询问选择哪个目标",fillcolor="#fff5dc"];
one [label="继续使用\n无需额外询问"];
note [label="双向箭头：循环训练兼寻址\n向下可描述一次定位方向，不是全体系单向流程\n设计说明；不新增实验结果；FSM 本轮不修改",fillcolor="#fff5dc"];
input -> ca;
ca -> ea [dir=both,penwidth=2];
ea -> ka [dir=both,penwidth=2];
seed -> ea [style=dotted,label="训练预设"];
ca -> memory [dir=both,style=dashed,label="检索与材料返回"];
ka -> count;
count -> none [label="0"];
count -> one [label="1"];
count -> many [label=">1"];
none -> input [style=dashed,label="答复后继续当前问题"];
many -> input [style=dashed];
note -> ca [style=dotted,arrowhead=none];
}
