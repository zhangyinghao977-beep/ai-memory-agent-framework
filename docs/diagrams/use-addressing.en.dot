digraph G {
graph [rankdir=TB, bgcolor="#ffffff", pad="0.3", nodesep="0.35", ranksep="0.4", fontname="Noto Sans CJK SC", fontsize=18, labelloc=t, label="Use-side addressing: CA → EA → KA (design, not implementation validation)"];
node [shape=box, style="rounded,filled", fillcolor="#eef4ff", color="#55718f", fontname="Noto Sans CJK SC", fontsize=12, margin="0.16,0.12"];
edge [color="#55718f", fontname="Noto Sans CJK SC", fontsize=10];
input [label="Current question and context"];
ca [label="CA · Chain Attention\nFormerly PA · Page Attention\nLocate the core sentence and focus across chains"];
context [label="Use context to complete missing objects\nCheck for conflicts"];
conflict [label="Ambiguous or conflicting target?",shape=diamond];
clarify [label="Clarify the target of this question\nDo not turn it into a global default",fillcolor="#fff5dc"];
ea [label="EA · learning event chain, used here for addressing\nLocate required SLOT keyword relations"];
ka [label="KA · relative to a fixed reference within a package\nAddress corresponding knowledge and members"];
output [label="Use knowledge under current conditions\nRetain sources, unknowns and scope"];
note [label="Scope boundary\nThis is use-side addressing\nNot a fixed single pass for all learning/training\nFormation retains package and EA learning loops",shape=note,fillcolor="#fff5dc"];
input -> ca;
ca -> context;
context -> conflict;
conflict -> clarify [label="Yes"];
clarify -> context [label="Bind clarification; resume the original chain"];
conflict -> ea [label="No conflict"];
ea -> ka;
ka -> output;
note -> ca [style=dashed,arrowhead=none,label="Current definition"];
}
