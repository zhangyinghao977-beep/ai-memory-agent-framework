digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45", fontname="Noto Sans CJK SC", fontsize=18, labelloc=t, label="CA ↔ EA ↔ KA"];
node [shape=box, style="rounded,filled", fillcolor="#eef4ff", color="#55718f", fontname="Noto Sans CJK SC", fontsize=12, margin="0.16,0.12"];
edge [color="#55718f", fontname="Noto Sans CJK SC", fontsize=10];
input [label="Current passage and question"];
seed [label="Training initialization: preset slots and EA\nLanguage positions + collocations → packages\nCondensation nuclei, not an alternative use entry",fillcolor="#fff5dc"];
ca [label="CA · Chain Attention (formerly PA)\nAcross-statement relations, implicit merging, question\nAssociate earlier experiences when needed"];
ea [label="EA · Learning event chain\nExample: independently ending statement portion\nTrained positions are slots; each corresponds to KA"];
ka [label="KA · Seek a knowledge candidate queue\nWithin-package reference and member relations"];
memory [label="Existing memory route\nKeywords / multilevel indexes → descriptions → originals\nAssociate participants, time, topic and original text\nSummaries do not replace originals"];
count [label="Candidate count?",shape=diamond];
none [label="Ask directly\nNo extra registration solely for not found",fillcolor="#fff5dc"];
many [label="Ask which target to select",fillcolor="#fff5dc"];
one [label="Continue use\nNo additional question required"];
note [label="Bidirectional arrows: cyclic training and addressing\nDownward direction can show one lookup, not the entire system\nDesign only; no new results; FSM unchanged in this revision",fillcolor="#fff5dc"];
input -> ca;
ca -> ea [dir=both,penwidth=2];
ea -> ka [dir=both,penwidth=2];
seed -> ea [style=dotted,label="training preset"];
ca -> memory [dir=both,style=dashed,label="retrieval / returned material"];
ka -> count;
count -> none [label="0"];
count -> one [label="1"];
count -> many [label=">1"];
none -> input [style=dashed,label="reply resumes current question"];
many -> input [style=dashed];
note -> ca [style=dotted,arrowhead=none];
}
